# Copy to terraform.tfvars (git-ignored) and edit.
#
# No secrets belong in this file. Tokens and the database password are
# generated by OpenTofu and read back from outputs; the only reason to set one
# here is cutting over from an existing deployment without reconfiguring
# clients, and even then prefer TF_VAR_client_token_overrides in the
# environment over a value on disk.

# Required. Pin by digest: the digest IS the deployed version, and a moving tag
# makes `tofu plan` say "no changes" while the code underneath moves.
memory_image = "ghcr.io/rzem-ai/agent-memory@sha256:REPLACE_ME"

# Required. No default, on purpose - a server pointed at the wrong database
# returns nothing rather than failing.
database_name = "memory"

# Local daemon. For a remote host:
#   docker_host     = "ssh://deploy@memory.internal"
#   docker_ssh_opts = ["-o", "StrictHostKeyChecking=yes", "-i", "/home/me/.ssh/deploy"]

# Loopback unless a TLS reverse proxy or firewall fronts the port.
bind_address   = "127.0.0.1"
published_port = 3010

# One named token per client: legible access logs, surgical revocation.
clients = {
  claude-code = {
    agents = ["default"]
    scopes = ["memory:read", "memory:write", "memory:admin"]
  }
  # ingestion = {
  #   agents = ["pipeline"]
  #   scopes = ["memory:read"]
  # }
}

# Mount the synced Markdown vault read-only, so memory_read_document serves
# original file bodies instead of reconstructing them from chunks.
# vault_host_dir = "/srv/vault"

# Accept IdP-issued JWTs alongside static tokens. Required for claude.ai remote
# connectors. The server refuses to boot if these are left as example.com.
# oauth = {
#   issuer   = "https://id.example.com/realms/main"
#   audience = "https://memory.example.com"
#   jwks_uri = "https://id.example.com/realms/main/protocol/openid-connect/certs"
# }

# Adopt volumes from an existing Compose deployment rather than starting empty.
# Compose names them <project>_<volume>. Import them before the first apply.
# postgres_volume_name = "agent-memory_postgres-data"
# ollama_volume_name   = "agent-memory_ollama-data"

# ollama_gpus = "all"
