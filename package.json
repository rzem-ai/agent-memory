{
  "name": "@rzem-ai/agent-memory",
  "version": "1.0.0",
  "description": "Long-term memory for AI agents: an MCP server over Postgres + pgvector with cross-corpus semantic recall, self-deduplicating capture, and namespace isolation by credential.",
  "license": "MIT",
  "author": "Alex Rzemieniuk",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rzem-ai/agent-memory.git"
  },
  "bugs": {
    "url": "https://github.com/rzem-ai/agent-memory/issues"
  },
  "homepage": "https://github.com/rzem-ai/agent-memory#readme",
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "ai-agents",
    "long-term-memory",
    "postgres",
    "pgvector",
    "embeddings",
    "ollama",
    "typescript"
  ],
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "main": "dist/index.js",
  "files": [
    "dist/",
    "docs/",
    "migrations/",
    "skills/",
    "mcp.example.toml"
  ],
  "scripts": {
    "build": "node scripts/clean-dist.mjs && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src tests",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run lint && npm run typecheck && npm test && npm run build",
    "start": "node dist/index.js",
    "start:http": "node dist/index.js",
    "start:stdio": "node dist/stdio.js",
    "dev:http": "tsx src/index.ts",
    "dev:stdio": "tsx src/stdio.ts",
    "migrate": "node dist/cli/migrate.js",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/node": "^2.0.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "drizzle-orm": "^0.45.2",
    "jose": "^6.1.0",
    "js-yaml": "^4.1.0",
    "pg": "^8.22.0",
    "pino": "^10.3.1",
    "smol-toml": "^1.6.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@modelcontextprotocol/client": "^2.0.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^25.5.0",
    "@types/pg": "^8.11.10",
    "eslint": "^9.39.1",
    "globals": "^16.5.0",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.52.0",
    "v1sdk": "npm:@modelcontextprotocol/sdk@1.29.0",
    "vitest": "^4.0.18"
  }
}
