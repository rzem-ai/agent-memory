# Copy to .env before running Docker Compose. Never commit the populated file.
#
# No secrets live here. The database password and the bearer token are files
# under .secrets/, bind-mounted to /run/secrets; see docs/DOCKER.md.

# Loopback is the safe default. Set 0.0.0.0 only when a firewall or TLS reverse
# proxy protects the published port.
AGENT_MEMORY_BIND=127.0.0.1
AGENT_MEMORY_PORT=3010

# Optional: use a prebuilt application image instead of the local build.
# AGENT_MEMORY_IMAGE=ghcr.io/rzem-ai/agent-memory:latest
